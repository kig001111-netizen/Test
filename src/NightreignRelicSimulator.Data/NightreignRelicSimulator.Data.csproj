<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NightreignRelicSimulator.Data</RootNamespace>
    <AssemblyName>NightreignRelicSimulator.Data</AssemblyName>
    <Description>SQLite アクセスと Repository 実装を提供するデータ層</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightreignRelicSimulator.Core\NightreignRelicSimulator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
